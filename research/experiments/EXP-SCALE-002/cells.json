   "{cache}/A.7z"
  ],
  "A.eb": [
   "/root/eb-research/target/scale-prod/release/ebound",
   "pack",
   "{input}",
   "{cache}/A.eb",
   "--profile",
   "balanced"
  ],
  "A.gz": [
   "bash",
   "-c",
   "gzip -6 -n -c \"$(find \"$1\" -type f | head -1)\" > \"$2\"",
   "sh",
   "{input}",
   "{cache}/A.gz"
  ],
  "A.tar": [
   "bash",
   "-c",
   "tar -C \"$1\" --format=pax --sort=name --mtime=@946684800 --owner=0 --group=0 --numeric-owner -cf - . > \"$2\"",
   "sh",
   "{input}",
   "{cache}/A.tar"
  ],
