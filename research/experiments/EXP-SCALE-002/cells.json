   "sh",
   "{input}",
   "{cache}/A.tar.gz"
  ],
  "A.tar.xz": [
   "bash",
   "-c",
   "tar -C \"$1\" --format=pax --sort=name --mtime=@946684800 --owner=0 --group=0 --numeric-owner -cf - . | xz -T1 -6 > \"$2\"",
   "sh",
   "{input}",
   "{cache}/A.tar.xz"
  ],
  "A.tar.zst": [
   "bash",
   "-c",
   "tar -C \"$1\" --format=pax --sort=name --mtime=@946684800 --owner=0 --group=0 --numeric-owner -cf - . | zstd {flags} -q -o \"$2\"",
   "sh",
   "{input}",
   "{cache}/A.tar.zst"
  ],
  "A.zip": [
   "bash",
   "-c",
   "cd \"$1\" && zip -q -r -X \"$2\" .",
